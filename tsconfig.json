{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "theme": ["./theme"],
      "theme/*": ["./theme/*"],
      "components/*": ["./components/*"],
      "contexts/*": ["./contexts/*"],
      "lib/*": ["./lib/*"],
      "assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
