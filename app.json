{
  "expo": {
    "name": "fakaba-mobile",
    "slug": "fakaba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "fr"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.blessdaeah.fakaba"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "fakaba.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr"
            ],
            "android": [
              "en-US",
              "fr"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1300A7",
          "dark": {
            "image": "./assets/images/logo-mark.png",
            "backgroundColor": "#1300A7"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fakaba uses your location while the app is open to suggest places near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fakaba needs access to your photos so you can add a profile picture or logo.",
          "cameraPermission": "Fakaba uses the camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b506a58b-6fc4-445e-a7b1-4a18937a1e26"
      }
    },
    "owner": "darah-b-studios"
  }
}
